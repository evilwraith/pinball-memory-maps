{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tomlogic/pinball-memory-maps/main/schema/index.schema.json",
  "title": "Pinball Memory Map Index",
  "description": "Schema for index.json, mapping PinMAME ROM names to map files. Generated by tools/update-index.py.",
  "type": "object",
  "properties": {
    "_note": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "string",
    "pattern": "^maps/.+\\.map\\.json$"
  }
}
